# Copie para .env e preencha. Nunca versione o .env.

# Banco (SQLite local por padrão; PostgreSQL: postgresql+psycopg://user:senha@host:5432/moeda_estudantil)
DATABASE_URL=sqlite:///./moeda_estudantil.db

# Sessão: troque o segredo fora do desenvolvimento e use COOKIE_SECURE=true com HTTPS
SESSION_SECRET=troque-este-segredo
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Área /admin (cadastro de instituições e professores). Vazio = área desativada.
ADMIN_TOKEN=

# E-mail via Mailtrap (Email Testing > Inboxes > SMTP Settings). Vazio = e-mails só vão para o log.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Moeda Estudantil <noreply@moeda.local>
