@startuml diagrama-de-componentes
title Sistema de Moeda Estudantil - Diagrama de Componentes
skinparam shadowing false
skinparam componentStyle uml2

package "Sistema de Moeda Estudantil" {
  [Interface Web\n(View)] as UI
  [Modulo de Autenticacao] as Auth
  [Modulo de Cadastro] as Cadastro
  [Modulo de Moedas] as Moedas
  [Modulo de Vantagens] as Vantagens
  [Modulo de Notificacao] as Notif
}

database "Banco de Dados" as DB
cloud "Servidor de E-mail\n(SMTP)" as SMTP

UI --> Auth
UI --> Cadastro
UI --> Moedas
UI --> Vantagens

Cadastro --> Auth
Moedas --> Auth
Vantagens --> Auth

Moedas --> Notif
Vantagens --> Notif

Auth --> DB
Cadastro --> DB
Moedas --> DB
Vantagens --> DB

Notif --> SMTP

note right of Auth
  Login e validacao de senha
  de todos os perfis
end note
note right of Moedas
  Envio de moedas, extrato,
  regras de saldo e credito semestral
end note
note right of Vantagens
  Cadastro de vantagens, troca,
  geracao de codigo do cupom
end note
@enduml
